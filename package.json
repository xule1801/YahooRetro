{
  "name": "yahoochat",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "services/api",
    "apps/windows"
  ],
  "scripts": {
    "infra:up": "docker compose -f infra/docker-compose.yml --env-file infra/.env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file infra/.env down",
    "db:migrate": "npm run migrate -w services/api",
    "api": "npm run start -w services/api",
    "cli": "npm run cli -w services/api --",
    "test": "npm test -w packages/contracts -w services/api -w apps/windows",
    "typecheck": "npm run typecheck -w services/api",
    "client": "npm start -w apps/windows",
    "client:dist": "npm run dist -w apps/windows",
    "load": "node tests/load/load.mjs",
    "test:infra:up": "docker compose -p yahoochat-test -f infra/docker-compose.yml --env-file infra/.env.test up -d",
    "test:infra:down": "docker compose -p yahoochat-test -f infra/docker-compose.yml --env-file infra/.env.test down"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED"
}
