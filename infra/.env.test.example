# Bộ máy chủ RIÊNG cho test tự động — test xóa dữ liệu thoải mái ở đây, không đụng môi trường dùng thử (infra/.env).
YC_TEST_STACK=1
YC_COMPOSE_PROJECT=yahoochat-test
YC_COMPOSE_ENV_FILE=.env.test
YC_PG_OWNER_PASSWORD=change-me
YC_APP_DB_PASSWORD=change-me
YC_PROSODY_DB_PASSWORD=change-me
YC_XMPP_TOKEN_SECRET=change-me
YC_BACKUP_KEY=change-me
YC_DOMAIN=localhost
YC_PG_PORT=5434
YC_XMPP_PORT=5232
YC_XMPPS_PORT=5233
YC_XMPP_SERVICE=xmpp://127.0.0.1:5232
YC_XMPP_PUBLIC_SERVICE=xmpps://127.0.0.1:5233
YC_SMTP_PORT=1035
YC_MAILPIT_HTTP_PORT=8035
YC_MESSAGE_TTL_DAYS=30
YC_DEV_INSECURE_TLS=1
